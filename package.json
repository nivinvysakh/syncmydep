{
  "name": "syncmydep",
  "version": "1.3.0",
  "description": "GitHub Action that detects package.json and lockfile mismatches, audits vulnerabilities, resolves them, and automatically opens a Pull Request.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": [
    "github-action",
    "dependencies",
    "package.json",
    "package-lock.json",
    "audit",
    "npm",
    "yarn",
    "pnpm",
    "pull-request"
  ],
  "author": "Nivin Vysakh",
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.1",
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^10.9.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "undici": ">=6.21.1"
  }
}