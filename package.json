{
  "name": "syncmydep",
  "version": "1.4.1",
  "description": "GitHub Action that detects package.json and lockfile mismatches, audits vulnerabilities, resolves them, and automatically opens a Pull Request.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt && ncc build src/cli.ts -o dist-cli --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": [
    "github-action",
    "dependencies",
    "package.json",
    "package-lock.json",
    "audit",
    "npm",
    "yarn",
    "pnpm",
    "pull-request"
  ],
  "author": "Nivin Vysakh",
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0",
    "@actions/io": "^1.1.3",
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^10.9.1",
    "jest": "^29.7.0",
    "jest-util": "^30.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "overrides": {
    "uuid": "^9.0.1"
  }
}
