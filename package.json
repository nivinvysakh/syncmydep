{
  "name": "syncmydep",
  "version": "1.0.0",
  "description": "GitHub Action that detects package.json and lockfile mismatches, audits vulnerabilities, resolves them, and automatically opens a Pull Request.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist --source-map --license licenses.txt",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": [
    "github-action",
    "dependencies",
    "package.json",
    "package-lock.json",
    "audit",
    "npm",
    "yarn",
    "pnpm",
    "pull-request"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "eslint": "^10.9.0",
    "jest": "^29.7.0"
  }
}
